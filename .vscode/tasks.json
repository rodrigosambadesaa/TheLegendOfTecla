{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Levantar Docker GUI con Debug",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "./run-gui.ps1"
            ],
            "group": "none",
            "problemMatcher": [],
            "options": {
                "env": {
                    "TECLA_GUI_ENABLE_DEBUG": "true"
                }
            }
        },
        {
            "label": "Detener Docker GUI",
            "type": "shell",
            "command": "docker",
            "args": [
                "compose",
                "down"
            ],
            "group": "none",
            "problemMatcher": []
        },
        {
            "label": "Compilar Java (sin Maven)",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-Command",
                "$files = Get-ChildItem -Recurse -Filter *.java src/main/java | ForEach-Object { $_.FullName }; if (Test-Path out) { Remove-Item -Recurse -Force out }; javac -encoding UTF-8 -d out $files"
            ],
            "group": "build",
            "problemMatcher": [
                "$javac"
            ]
        }
    ]
}
