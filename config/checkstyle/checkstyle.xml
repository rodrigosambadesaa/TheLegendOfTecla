<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Puertas objetivas aplicadas a produccion y pruebas. El limite de archivo evita
  que nuevas responsabilidades vuelvan a concentrarse en clases monstruosas.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>
    <module name="FileLength">
        <property name="max" value="1700"/>
    </module>
    <module name="RegexpSingleline">
        <property name="format" value="\s+$"/>
        <property name="message" value="La línea contiene espacios finales."/>
    </module>
</module>
